\javaSource "methodExample/"; // location of class definitions

\programVariables {
  Person p;
  int x;
}

\functions {
  boolean c;
}

/*\predicates {
    c;
}*/

\rules {
/* TODO: Remove all simplifyRules besides one for terms, one for formulae, and one for updates (like in updateRules.key).
    Need to use a varcond (that does the same for event updates as dropEffectless.. does for elementary updates),
    because there can be a finite amount of event updates, good luck writing rules for all of the combinations. */
  simplifyEventUpdateOnTerm {
    \schemaVar \update u;
    \schemaVar \term any t;
    \schemaVar \term any result;
    \find({u}t)
    \varcond(\dropEffectlessEventUpdates(u, t, result))
    \replacewith(result)
    \heuristics(update_elim)
  };

  simplifyEventUpdateOnFormula {
    \schemaVar \update u;
    \schemaVar \formula phi, result;
    \find({u}phi)
    \varcond(\dropEffectlessEventUpdates(u, phi, result))
    \replacewith(result)
    \heuristics(update_elim)
 };

  simplifyEventUpdateOnUpdate {
    \schemaVar \update u;
    \schemaVar \update u2;
    \schemaVar \update result;
    \find({u}u2)
    \varcond(\dropEffectlessEventUpdates(u, u2, result))
    \replacewith(result)
    \heuristics(update_elim)
 };
/*
  simplifyParallelEventUpdateOnPV2 {
    \schemaVar \update u;
    \schemaVar \update evtU;
    \schemaVar \program Variable pv;
    \find({evtU || u}pv)
    \varcond(\isEventUpdate(evtU), \not \containsEvent(pv))
    \replacewith({u}pv)
    \heuristics(update_elim)
  };*/


  applyParallelEventUpdateOnEventCon {
    \schemaVar \update u;
    \schemaVar \term Event evtInUpdate;
    \schemaVar \term int evtNr;
    \schemaVar \term Event evt;
    \schemaVar \term boolean cond;
    \find({u || \eventUpdate(evtInUpdate, evtNr)}eventCon(evt, cond))
    \replacewith({u}cond=TRUE & {u}evt=evtInUpdate | eventCon({u || \eventUpdate(evtInUpdate, evtNr)}evt, {u || \eventUpdate(evtInUpdate, evtNr)}cond))
    \heuristics(update_apply)
  };

/*
  simplifyEventUpdateOnUpdate {
    \schemaVar \update u;
    \schemaVar \update u2;
    \find({u}u2)
    \varcond(\isEventUpdate(u), \not \containsEvent(u2))
    \replacewith(u2)
    \heuristics(update_elim)
  };*/

  applyUpdateOnEventUpdate {
    \schemaVar \update u;
    \schemaVar \term Event evt;
    \schemaVar \term int evtNr;
    \find({u}(\eventUpdate(evt, evtNr)))
    \replacewith(\eventUpdate({u}evt, {u}evtNr))
    \heuristics(update_apply_on_update)
  };

  /*
   +==========+
   + SHIFTING +
   +==========+
  */
 // TODO: Sound?
 // Can't shift with event updates because the order is important.
 /*
  shiftEventUpdateRightAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA {
    \schemaVar \update u;
    \schemaVar \update evtU;
    \find(evtU || u)
    \varcond(\isEventUpdate(evtU), \not \isEventUpdate(u))
    \replacewith(u || evtU)
    \heuristics(update_eu_shift)
  };

  shiftEventUpdateRightInMultiParallelAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA {
    \schemaVar \update otherU;
    \schemaVar \update u;
    \schemaVar \update evtU;
    \find(otherU || evtU || u)
    \varcond(\isEventUpdate(evtU), \not \isEventUpdate(u))
    \replacewith(otherU || u || evtU)
    \heuristics(update_eu_shift)
  };*/
}

\problem {
          {eventNr:=0} /* Declaration in 'event.key', this has to be used when events are argue about temporal
          properties, e.g. event1 happens before event2. */
          {p.age:=2} // assign initial value to 'age'
            (   x = 0 & p != null
             -> \<{
                    p.birthday();
                    //p.birthday();
                  }\> (p.age > x & eventCon(event(p, Person#birthday, seqEmpty), \if(p.age + 1 > x)\then(TRUE)\else(FALSE))))
// (p.age > x & eventCon(event(p, Person#birthday, seqEmpty), \if(p.age > x)\then(TRUE)\else(FALSE))))
// (p.age > x & eventCon(event(p, Person#birthday, seqEmpty), \if(p.age=3)\then(TRUE)\else(FALSE)) & eventCon(event(p, Person#birthday, seqEmpty), \if(p.age=4)\then(TRUE)\else(FALSE)))
//eventSeq(ec1
}
