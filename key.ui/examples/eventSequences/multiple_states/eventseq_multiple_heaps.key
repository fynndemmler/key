\javaSource "src/";

\programVariables {
    Client self;
    Client receiver;
    Mail mail;
}

\rules {
  applyMcUpdateOnSkip {
    \schemaVar \update eu;
    \find({eu}skip)
    \varcond(\isMcUpdate(eu))
    \replacewith(skip)
    \heuristics(concrete) // must be high prio than simplifyOnTerm, else we loop on simplifyOnTerm
  };
  applyUpdateOnMcUpdate {
    \schemaVar \update u;
    \schemaVar \term MethodId mId;
    \find({u}(mcUpdate(mId)))
    \varcond(\not \containsMcUpdate(u)) // TODO: Remove if it should be the same for event updates
    \replacewith(mcUpdate({u}mId))
    \heuristics(update_apply_on_update)
  };
/*
  shiftParallelUpdateOnEventSeqTEEEEEEEEEEEEEEEEEEESSSSSSSSSSSSSSTTTTTTTTTTT {
    \schemaVar \update u1, u2, eu;
    \schemaVar \term Seq events;
    \find({u1 || eu || u2}eventSeq(events))
    \varcond(\isMcUpdate(eu))
    \replacewith({u1 || u2 || eu}eventSeq(events))
    \heuristics(update_apply)
  };*/


/*applyParallelMcUpdateOnEventSeq {
    \schemaVar \term Seq events;
    \schemaVar \update u, eventU;
    \find({u || eventU}eventSeq(events))
    \varcond(\isMcUpdate(eventU))
            \replacewith({u || eventU}(seqEmpty = events | ((seqLen(events) >= 1 -> (boolean::seqGet(events, 0) = TRUE)) & (seqLen(events) > 1 -> eventSeq(seqSub(events, 1, seqLen(events)))))))
    \heuristics(update_apply)
};*/

/*
applyParallelMcUpdateOnEventSeq {
    \schemaVar \term Seq events;
    \schemaVar \update u, u2;
    \find({u || u2}eventSeq(events))
    \replacewith({u || u2}(boolean::seqGet(events, 0) = seqEmpty | ((seqLen(events) >= 1 -> (boolean::seqGet(events, 0) = TRUE)) & (seqLen(events) > 1 -> eventSeq(seqSub(events, 1, seqLen(events)))))))
    \heuristics(update_apply)
};*/

/*
applyParallelMcUpdateOnEventSeq {
    \schemaVar \term Seq events;
    \schemaVar \update u, u2;
    \find(eventSeq(events))
    \replacewith((boolean::seqGet(events, 0) = seqEmpty | (seqLen(events) = 1 & (boolean::seqGet(events, 0) = TRUE)) | (seqLen(events) > 1 & ((boolean::seqGet(events, 0) = TRUE) & eventSeq(seqSub(events, 1, seqLen(events)))))))
    \heuristics(update_apply)
};*/

/*
shiftEU1 {
    \schemaVar \update eu;
    \schemaVar \program Variable pv;
    \schemaVar \term any t;
    \find(eu || pv:=t)
    \varcond(\isMcUpdate(eu))
    \replacewith(pv:=t || eu)
    \heuristics(update_apply)
};

shiftEU2 { // TODO need varcond to ensure u is not a parallel update which might contain an event update
    \schemaVar \update eu, u;
    \find(eu || u)
    \varcond(\containsMcUpdate(eu), \not \containsMcUpdate(u))
    \replacewith(u || eu)
    \heuristics(update_apply)
};*/

/*
shiftEU2 {
    \find(eu || pv:=t || u2)
    \replacewith(pv:=t || eu || u2)
    \heuristics(
};*/
    simplifyParallelMcUpdateOnUpdate { // Last win semantics.
        \schemaVar \update u, eu1, eu2;
        \find({eu1 || eu2}u)
        \varcond(\isMcUpdate(eu1), \containsMcUpdate(eu2))
        \replacewith({eu2}u)
        \heuristics(update_elim)
    };

    applyChainMcUpdateOnEventSeq {
        \schemaVar \term Seq events;
        \schemaVar \update eventU, u;
        \find({eventU}eventSeq(events))
        \varcond(\containsMcUpdate(eventU))
        \replacewith({eventU}(boolean::seqGet(events, 0) = seqEmpty | ((seqLen(events) >= 1 -> (boolean::seqGet(events, 0) = TRUE)) & (seqLen(events) > 1 -> eventSeq(seqSub(events, 1, seqLen(events)))))))
        \heuristics(update_apply)
    };

    applyParallelChainMcUpdateOnEventSeq {
        \schemaVar \term Seq events;
        \schemaVar \update eventU;
        \schemaVar \update u1, u2;
        \find({u1 || eventU}eventSeq(events))
        \varcond(\containsMcUpdate(eventU))
        \replacewith({eventU}eventSeq({u1}events))
        \heuristics(update_apply)
    };

    applyParallelChainMcUpdateOnEvent {
        \schemaVar \term MethodId mid;
        \schemaVar \term boolean c;
        \schemaVar \update eventU;
        \schemaVar \update u1, u2;
        \find({u1 || eventU}event(mid, c))
        \varcond(\containsMcUpdate(eventU))
        \replacewith({eventU}event({u1}mid, {u1}c))
        \heuristics(update_apply)
    };

   applyChainMcUpdateOnEventCon {
        \schemaVar \term MethodId mIdInUpdate;
        \schemaVar \term MethodId mId;
        \schemaVar \term boolean cond;
        \schemaVar \update eu, u;
        \find({{u}mcUpdate(mIdInUpdate)}event(mId, cond))
        \replacewith({u}(cond=TRUE & mId=mIdInUpdate) | event({{u}mcUpdate(mIdInUpdate)}mId, {{u}mcUpdate(mIdInUpdate)}cond))
        \heuristics(update_apply)
    };
}


\problem {
        (self != null & receiver != null & mail != null & mail.isEncrypted = TRUE
         -> {mail.isEncrypted := TRUE}\<{
                self.decrypt(mail);
                self.addToInbox(mail);
                self.send(receiver, mail);
              }\> (eventSeq(seqConcat(seqSingleton(\if(event(Client#decrypt$Mail, \if(mail.isEncrypted@heapAtClient#decrypt$Mail=TRUE)\then(TRUE)\else(FALSE)))\then(TRUE)\else(FALSE)), seqSingleton(\if(event(Client#send$Client_Mail, \if(mail.isEncrypted@heapAtClient#send$Client_Mail=FALSE)\then(TRUE)\else(FALSE)))\then(TRUE)\else(FALSE))))))
}
