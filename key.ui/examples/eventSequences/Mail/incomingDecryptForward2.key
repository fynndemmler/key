\javaSource "src";

\programVariables {
    Client self;
    Client client;
    Client receiver;
    Email msg;
    int privkey;
    boolean cond1;
    boolean cond2;
}

\problem {
        wellFormed(heap)
       & !self = null
       & boolean::select(heap, self, java.lang.Object::<created>) = TRUE
       & Client::exactInstance(self) = TRUE
       & (  ((client = null | boolean::select(heap, client, java.lang.Object::<created>) = TRUE)<<SC>>)
          & ((msg = null | boolean::select(heap, msg, java.lang.Object::<created>) = TRUE)<<SC>>))
       & measuredByEmpty
       & ((  ((!client = null
           & !msg = null)<<SC>>
           &   boolean::select(heap, msg, Email::$isEncrypted)
             = \if (true)  \then (TRUE)  \else (FALSE))<<SC>>
           & ((  java.lang.Object::<inv>(heap, self)<<impl>>
               & (((!client = null)<<impl>> & (!msg = null)<<impl>>)<<SC>>))<<SC>>))<<SC>>)
    ->
         \<{
            cond1 = msg.isEncrypted == true;
            msg.setEmailIsEncrypted(true);
            receiver = client.getForwardReceiver();
            cond2 = msg.isEncrypted == false;
            if (receiver != null && msg != null) {
                self.forward(receiver, msg);
            }
         }\> (  true)
}

