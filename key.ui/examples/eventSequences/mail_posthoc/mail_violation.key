\javaSource "src/";

\programVariables {
    Client self;
    Client receiver;
    Mail mail;
}

\rules {
    pMCUonE1 {
        \schemaVar \update u;
        \schemaVar \term MethodId mIdInUpdate;
        \schemaVar \term MethodId mId;
        \schemaVar \term boolean cond;
        \schemaVar \term Heap mcHeap;
        \find({u || mcUpdate(mIdInUpdate, mcHeap)}event(mId, cond))
        \replacewith({mcUpdate(mIdInUpdate, mcHeap)}(cond)=TRUE & {mcUpdate(mIdInUpdate, mcHeap)}mId=mIdInUpdate | {u}event({mcUpdate(mIdInUpdate, mcHeap)}mId, {mcUpdate(mIdInUpdate, mcHeap)}cond))
        \heuristics(update_late)
    };

    mcuOnFieldSelect {
        \schemaVar \term Object o;
        \schemaVar \term Field f;
        \schemaVar \term MethodId mid;
        \schemaVar \term Heap mcHeap, h;
        \find(any::select(h, o, {mcUpdate(mid, mcHeap)}f))
        \replacewith(any::select(mcHeap, o, f))
        \heuristics(update_apply)
    };

    mcuOnFieldStore {
        \schemaVar \term Object o;
        \schemaVar \term Field f;
        \schemaVar \term any t;
        \schemaVar \term MethodId mid;
        \schemaVar \term Heap mcHeap, h;
        \find(any::store(h, o, {mcUpdate(mid, mcHeap)}f, t))
        \replacewith(any::store(mcHeap, o, f, t))
        \heuristics(update_apply)
    };

    pmcuOnFieldSelect {
        \schemaVar \term Object o;
        \schemaVar \term Field f;
        \schemaVar \term MethodId mid;
        \schemaVar \term Heap mcHeap, h;
        \schemaVar \update u;
        \find(any::select(h, o, {u || mcUpdate(mid, mcHeap)}f))
        \replacewith(any::select(mcHeap, o, {u}f))
        \heuristics(update_apply)
    };

    pmcuOnFieldStore {
        \schemaVar \term Object o;
        \schemaVar \term Field f;
        \schemaVar \term any t;
        \schemaVar \term MethodId mid;
        \schemaVar \term Heap mcHeap, h;
        \schemaVar \update u;
        \find(any::store(h, o, {u || mcUpdate(mid, mcHeap)}f, t))
        \replacewith(any::store(mcHeap, o, {u}f, t))
        \heuristics(update_apply)
    };

    mcuOnField {
        \schemaVar \term Object o;
        \schemaVar \term MethodId mid;
        \schemaVar \term Heap mcHeap;
        \schemaVar \term Field f;
        \find({mcUpdate(mid, mcHeap)}f)
        \replacewith(any::select(mcHeap, o, f))
        \heuristics(update_apply)
    };
}

\problem {
        (self != null & receiver != null & mail != null & mail.isEncrypted = TRUE
         -> \<{
                self.decrypt(mail);
                self.addToInbox(mail);
                self.send(receiver, mail);
              }\> (!eventSeq(seqConcat(seqSingleton(\if(event(Client#decrypt$Mail, \if(mail.isEncrypted=TRUE)\then(TRUE)\else(FALSE)))\then(TRUE)\else(FALSE)), seqSingleton(\if(event(Client#send$Client_Mail, \if(mail.isEncrypted=FALSE)\then(TRUE)\else(FALSE)))\then(TRUE)\else(FALSE))))))
}
