\javaSource "methodExample/"; // location of class definitions

\programVariables {
  Person p;
  int x;
}


\rules {
/*
    eventSeqReduce {
        \schemaVar \term Seq event
    };*/

    eventSeqEmpty {
        \find(eventSeq(seqEmpty))
        \replacewith(true)
        \heuristics(update_elim)
    };
}

\problem {
          {eventNr:=0} /* Declaration in 'event.key', this has to be used when events are argue about temporal
          properties, e.g. event1 happens before event2. */
          {p.age:=2} // assign initial value to 'age'
            (   x = 0 & p != null)
             -> \<{
                    p.birthday();
                  }\> (p.age > x & eventSeq(seqEmpty))

                  /*(p.age > x & eventSeq(seqConcat(seqSingleton(eventCon(event(p, Person#birthday, seqEmpty), TRUE),
                  seqSingleton(eventCon(event(p, Person#birthday, seqEmpty), TRUE)))))*/
}
