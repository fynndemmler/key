\schemaVariables {
    \modalOperator {diamond, box, diamond_transaction, box_transaction} #allmodal;
    \modalOperator {diamond, diamond_transaction} #diamond;
    \modalOperator {box, box_transaction} #box;
    \program SimpleExpression #se, #se0, #se1, #se2;
    \program MethodName #mn;
    \program SimpleExpression #seMn;
    \program [list] SimpleExpression #selist;
    \program [list] Expression #elist;
}

\rules(events:on, programRules:Java, runtimeExceptions:ban) {
    /*=================*/
    /*      EVENTS     */
    /*=================*/
    methodCall {
       \schemaVar \formula post;
       \schemaVar \term Object rp;
       \schemaVar \term MethodId mId;
       \schemaVar \term Seq params;
       \find( ==> \modality{#allmodal}{.. #se.#mn(#selist); ...}\endmodality post)
       \varcond(\not \staticMethodReference(#se, #mn, #selist), \mayExpandMethod(#se, #mn, #selist), \getMethodIdentifier(mId, #se, #mn, #selist))
       "Normal Execution (#se != null)":
           \replacewith( ==> {mcUpdate(mId)}\modality{#allmodal}{.. #method-call(#se.#mn(#selist)); ...}\endmodality (post));
           //\add( ==> #se = null);
       "Null Reference (#se = null)":
           \replacewith( ==> \modality{#allmodal}{.. throw new java.lang.NullPointerException(); ...}\endmodality (post)) \add(#se = null ==>)
       \heuristics(update_apply)
    };

    MCUonE {
        \schemaVar \term MethodId mIdInUpdate;
        \schemaVar \term MethodId mId;
        \schemaVar \term boolean cond;
        \find({mcUpdate(mIdInUpdate)}event(mId, cond))
        \sameUpdateLevel
        \replacewith(({mcUpdate(mIdInUpdate)}cond)=TRUE & ({mcUpdate(mIdInUpdate)}mId)=mIdInUpdate | event({mcUpdate(mIdInUpdate)}mId, {mcUpdate(mIdInUpdate)}cond))
        \heuristics(update_elim)
    };

/*
    MCUPonE {
        \schemaVar \term MethodId mIdInUpdate;
        \schemaVar \term MethodId mId;
        \schemaVar \term seq params;
        \schemaVar \term boolean cond;
        \find({mcUpdate(mIdInUpdate)}event(mId, cond))
        \sameUpdateLevel
        \replacewith(({mcUpdate(mIdInUpdate)}cond)=TRUE & ({mcUpdate(mIdInUpdate)}mId)=mIdInUpdate | event({mcUpdate(mIdInUpdate)}mId, {mcUpdate(mIdInUpdate)}cond))
        \heuristics(update_elim)
    };*/

    simplifyMCUonMID {
        \schemaVar \update eu;
        \schemaVar \term MethodId mId;
        \find({eu}mId)
        \varcond(\isMcUpdate(eu))
        \replacewith(mId)
        \heuristics(update_elim)
    };

    simplifyPMCUonMID {
        \schemaVar \update eu;
        \schemaVar \update u;
        \schemaVar \term MethodId mId;
        \find({u || eu}mId)
        \varcond(\isMcUpdate(eu))
        \replacewith({u}mId)
        \heuristics(update_elim)
    };

    simplifyPMCUonMID2 {
        \schemaVar \update eu;
        \schemaVar \update u;
        \schemaVar \term MethodId mId;
        \find({eu || u}mId)
        \varcond(\isMcUpdate(eu))
        \replacewith({u}mId)
        \heuristics(update_elim)
    };

    simplifyChainMcUpdateOnMethodId {
        \schemaVar \update eu;
        \schemaVar \update u;
        \schemaVar \term MethodId mId;
        \find({{u}eu}mId)
        \varcond(\isMcUpdate(eu))
        \replacewith({u}mId)
        \heuristics(update_elim)
    };

    simplifyMCUonTerm {
        \schemaVar \update u;
        \schemaVar \term any t;
        \schemaVar \term any result;
        \find({u}t)
        \varcond(\dropEffectlessMcUpdates(u, t, result))
        \replacewith(result)
        \heuristics(update_elim)
    };

    simplifyMCUonFormula {
        \schemaVar \update u;
        \schemaVar \formula phi, result;
        \find({u}phi)
        \varcond(\dropEffectlessMcUpdates(u, phi, result))
        \replacewith(result)
        \heuristics(update_elim)
    };

    pMCUonE1 {
        \schemaVar \update u;
        \schemaVar \term MethodId mIdInUpdate;
        \schemaVar \term MethodId mId;
        \schemaVar \term boolean cond;
        \find({u || mcUpdate(mIdInUpdate)}event(mId, cond))
        \replacewith({u || mcUpdate(mIdInUpdate)}cond=TRUE & {u || mcUpdate(mIdInUpdate)}mId=mIdInUpdate | {u}event({mcUpdate(mIdInUpdate)}mId, {mcUpdate(mIdInUpdate)}cond))
        \heuristics(update_apply)
    };

    pMCUonE2 {
        \schemaVar \term MethodId mId;
        \schemaVar \term boolean c;
        \schemaVar \update mcu;
        \schemaVar \update u;
        \find({mcu || u}event(mId, c))
        \varcond(\isMcUpdate(mcu), \not \containsMcUpdate(u))
        \replacewith({mcu}event({u}mId, {u}c))
        \heuristics(update_apply)
    };

    NUonE {
        \schemaVar \update u;
        \schemaVar \term MethodId mId;
        \schemaVar \term boolean c;
        \find({u}event(mId, c))
        \varcond(\not \containsMcUpdate(u))
        \replacewith(event({u}mId, {u}c))
        \heuristics(update_apply)
    };

    pNUonE {
        \schemaVar \update u1, u2;
        \schemaVar \term MethodId mId;
        \schemaVar \term boolean c;
        \find({u1 || u2}event(mId, c))
        \varcond(\not \containsMcUpdate(u2))
        \replacewith({u1}event({u2}mId, {u2}c))
        \heuristics(update_apply)
    };

    elimFalseE {
        \schemaVar \term MethodId mid;
        \find(event(mid, FALSE))
        \replacewith(false)
        \heuristics(concrete)
    };

    /* By definition, an event can only be true if there exists a suitable method call. Therefore, any event not bound
     by a modality or update is false in the succedent.*/

    elimIsoE2 {
        \schemaVar \term MethodId mid;
        \schemaVar \term boolean c;
        \find(==> event(mid, c))
        \inSequentState
        \replacewith(==> false)
        \heuristics(concrete)
    };

    /*=================*/
    /*    SHIFTING     */
    /*=================*/

    shiftSU {
        \schemaVar \update su, mcu;
        \find(su || mcu)
        \varcond(\not \containsMcUpdate(su), \isMcUpdate(mcu))
        \replacewith(mcu || su)
        \heuristics(concrete) // Need new heuristic here that has less cost than update_apply
    };

    /*=================*/
    /* EVENT SEQUENCES */
    /*=================*/

/*
    MCUonES {
      \schemaVar \term Seq events;
      \schemaVar \update mcu;
      \find({mcu}eventSeq(events))
      \varcond(\isMcUpdate(mcu))
      \replacewith(boolean::seqGet(events, 0) = seqEmpty | (seqLen(events) >= 1 -> {mcu}(boolean::seqGet(events, 0) = TRUE) & (seqLen(events) > 1 -> eventSeq(seqSub(events, 1, seqLen(events))))) | ({mcu}boolean::seqGet(events, 0) = FALSE) -> eventSeq({mcu}events))
      \heuristics(update_apply)
    };

    pMCUonES {
      \schemaVar \term Seq events;
      \schemaVar \update u, mcu;
      \find({u || mcu}eventSeq(events))
      \varcond(\isMcUpdate(mcu))
      \replacewith(boolean::seqGet(events, 0) = seqEmpty | (seqLen(events) >= 1 -> {u || mcu}(boolean::seqGet(events, 0) = TRUE) & (seqLen(events) > 1 -> {u}eventSeq(seqSub(events, 1, seqLen(events))))) | ({u || mcu}(boolean::seqGet(events, 0) = FALSE) -> {u}eventSeq({mcu}events)))
      \heuristics(update_apply)
    };*/

    emptyES {
        \find(eventSeq(seqEmpty))
        \replacewith(true)
        \heuristics(update_elim)
    };

    NUonES {
        \schemaVar \update u;
        \schemaVar \term Seq events;
        \find({u}eventSeq(events))
        \varcond(\not \containsMcUpdate(u))
        \replacewith(eventSeq({u}events))
        \heuristics(update_apply)
    };

    pNUonES {
        \schemaVar \update u1, u2;
        \schemaVar \term Seq events;
        \find({u1 || u2}eventSeq(events))
        \varcond(\not \containsMcUpdate(u2))
        \replacewith({u1}eventSeq({u2}events))
        \heuristics(update_apply)
    };

    pMCUonES1 {
        \schemaVar \term Seq events;
        \schemaVar \update u1, u2;
        \find({u1 || u2}eventSeq(events))
        \varcond(\not \containsMcUpdate(u2))
        \replacewith({u1}eventSeq({u2}events))
        \heuristics(update_apply)
    };

    /* Check Soundness from here on out, because these are all rules newly
     added for the multi heap approach. */

   associativeMcu {
      \schemaVar \update u1, u2, mcu;
      \find(u1 || (u2 || mcu))
      \varcond(\isMcUpdate(mcu))
      \replacewith(u1 || u2 || mcu)
      \heuristics(update_apply)
   };

  applyMcUpdateOnSkip {
    \schemaVar \update eu;
    \find({eu}skip)
    \varcond(\isMcUpdate(eu))
    \replacewith(skip)
    \heuristics(concrete) // must be high prio than simplifyOnTerm, else we loop on simplifyOnTerm
  };

  applyUpdateOnMcUpdate {
    \schemaVar \update u;
    \schemaVar \term MethodId mId;
    \find({u}(mcUpdate(mId)))
    \varcond(\not \containsMcUpdate(u))
    \replacewith(mcUpdate({u}mId))
    \heuristics(update_apply_on_update)
  };

mcuOnMcuNew {
    \schemaVar \update mcu1, mcu2;
    \find({mcu1}mcu2)
    \replacewith(mcu2)
    \heuristics(update_apply)
};

  pmcuOnMcuNew {
    \schemaVar \update mcu1, mcu2, u;
    \find({u || mcu1}mcu2)
    \varcond(\isMcUpdate(mcu1), \isMcUpdate(mcu2))
    \replacewith({u}mcu2)
    \heuristics(update_elim)
  };

  // NEW method call update on event sequence rules with case destinction in antecedent
    falseES {
        \schemaVar \term Seq event;
        \find(eventSeq(seqSingleton(FALSE)))
        \replacewith(false)
        \heuristics(concrete)
    };

    MCUonESright {
      \schemaVar \term Seq events;
      \schemaVar \update mcu;
      \find(==>{mcu}eventSeq(events))
      \sameUpdateLevel
      \varcond(\isMcUpdate(mcu))
      "Event Sequence (Empty)":
          \replacewith(==>boolean::seqGet(events, 0) = seqEmpty);
      "Event Sequence (events[0] = TRUE)":
          \replacewith(==>seqLen(events) >= 1 & ({mcu}boolean::seqGet(events, 0) = TRUE & eventSeq(seqSub(events, 1, seqLen(events)))));
      "Event Sequence (events[0] = FALSE)":
          \replacewith(==>seqLen(events) >= 1 & (({mcu}boolean::seqGet(events, 0) = FALSE) & eventSeq(events)))
      \heuristics(update_apply)
    };

    MCUonESleft {
      \schemaVar \term Seq events;
      \schemaVar \update u, mcu;
      \find({mcu}eventSeq(events)==>)
      \sameUpdateLevel
      \varcond(\isMcUpdate(mcu))
      "Event Sequence (Empty)":
          \replacewith(boolean::seqGet(events, 0) = seqEmpty==>);
      "Event Sequence (events[0] = TRUE)":
          \replacewith(seqLen(events) >= 1 & ({mcu}boolean::seqGet(events, 0) = TRUE & eventSeq(seqSub(events, 1, seqLen(events))))==>);
      "Event Sequence (events[0] = FALSE)":
          \replacewith(seqLen(events) >= 1 & ({mcu}boolean::seqGet(events, 0) = FALSE & eventSeq(events))==>)
      \heuristics(update_apply)
    };

    pMCUonESright {
      \schemaVar \term Seq events;
      \schemaVar \update u, mcu;
      \find(==>{u || mcu}eventSeq(events))
      \sameUpdateLevel
      \varcond(\isMcUpdate(mcu))
      "Event Sequence (Empty)":
          \replacewith(==>boolean::seqGet(events, 0) = seqEmpty);
      "Event Sequence (events[0] = TRUE)":
          \replacewith(==>seqLen(events) >= 1 & ({u || mcu}boolean::seqGet(events, 0) = TRUE & {u}eventSeq(seqSub(events, 1, seqLen(events)))));
      "Event Sequence (events[0] = FALSE)":
          \replacewith(==>seqLen(events) >= 1 & (({u || mcu}boolean::seqGet(events, 0) = FALSE) & {u}eventSeq(events)))
      \heuristics(update_apply)
    };

    pMCUonESleft {
      \schemaVar \term Seq events;
      \schemaVar \update u, mcu;
      \find({u || mcu}eventSeq(events)==>)
      \sameUpdateLevel
      \varcond(\isMcUpdate(mcu))
      "Event Sequence (Empty)":
          \replacewith(boolean::seqGet(events, 0) = seqEmpty==>);
      "Event Sequence (events[0] = TRUE)":
          \replacewith(seqLen(events) >= 1 & ({u || mcu}boolean::seqGet(events, 0) = TRUE & {u}eventSeq(seqSub(events, 1, seqLen(events))))==>);
      "Event Sequence (events[0] = FALSE)":
          \replacewith(seqLen(events) >= 1 & ({u || mcu}boolean::seqGet(events, 0) = FALSE & {u}eventSeq(events))==>)
      \heuristics(update_apply)
    };
}
