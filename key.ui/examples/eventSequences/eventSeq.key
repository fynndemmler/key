\javaSource "methodExample/"; // location of class definitions

\programVariables {
  Person p;
  int x;
}

\problem {
      {eventNr:=0}
      {p.age:=2} // assign initial value to 'age'
        (   x = 0 & p != null
         -> \<{
                p.birthday();
              }\> (eventSeq(seqConcat(seqSingleton(\if(eventCon(event(p, Person#birthday, seqEmpty), \if(p.age>x)\then(TRUE)\else(FALSE)))\then(TRUE)\else(FALSE)), seqSingleton(\if(eventCon(event(p, Person#birthday, seqEmpty), \if(p.age>x)\then(TRUE)\else(FALSE)))\then(TRUE)\else(FALSE))))))  //eventSeq(eventCon (eventSeq(seqConcat(seqSingleton(\if(eventCon(event(p, Person#birthday, seqEmpty), \if(p.age>x)\then(TRUE)\else(FALSE)))\then(TRUE)\else(FALSE)), seqSingleton(\if(eventCon(event(p, Person#birthday, seqEmpty), \if(p.age>x)\then(TRUE)\else(FALSE)))\then(TRUE)\else(FALSE))))))

}

// works: /*p.age > x & eventSeq(seqSingleton(\if(eventCon(event(p, Person#birthday, seqEmpty), TRUE))\then(TRUE)\else(FALSE)))*/
