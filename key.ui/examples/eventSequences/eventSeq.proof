\javaSource "methodExample"; // location of class definitions

\programVariables {
  Person p;
  int x;
}

\rules {
    applyUpdateOnEventCon {
        \schemaVar \update u;
	\schemaVar \term Event e;
	\schemaVar \term boolean c;
        \find({u}eventCon(e, c))
        \varcond(\not \containsEventUpdate(u))
        \replacewith(eventCon({u}e, {u}c))
        \heuristics(update_apply)
    };
    applyUpdateOnEventSeq {
        \schemaVar \update u;
	\schemaVar \term Seq eventCons;
        \find({u}eventSeq(eventCons))
        \varcond(\not \containsEventUpdate(u))
        \replacewith(eventSeq({u}eventCons))
        \heuristics(update_apply)
    };

/*
    elimFalseEventCon {
        \schemaVar \term Event e;
        \schemaVar \term boolean c;
        \find(eventCon(e, FALSE))
        \replacewith(false)
        \heuristics(update_elim)
    };*/

    applyParallelEventUpdateOnEventCon {
        \schemaVar \term Event e;
        \schemaVar \term boolean c;
        \schemaVar \update eventU;
        \schemaVar \update u;
        \find({eventU || u}eventCon(e, c))
        \varcond(\isEventUpdate(eventU))
        \replacewith({eventU}eventCon({u}e, {u}c))
        \heuristics(update_apply)
    };

    applyParallelEventUpdateOnEventSeq {
        \schemaVar \term Seq eventCons;
        \schemaVar \term Event e;
        \schemaVar \term boolean c;
        \schemaVar \update eventU;
        \schemaVar \update u;
        \find({eventU || u}eventSeq(eventCons))
        \varcond(\isEventUpdate(eventU))
        \replacewith({eventU}eventSeq({u}eventCons))
        \heuristics(update_apply)
    };

}
\problem {
{eventNr:=Z(0(#))}
  {heap:=store(heap, p, Person::$age, Z(2(#)))}
    (   x = Z(0(#)) & !p = null
     -> \<{
          p.birthday();
        }\> eventSeq(seqConcat(seqSingleton(\if (eventCon(event(p,
                                                                Person#birthday,
                                                                seqEmpty),
                                                          \if (gt(int::select(heap,
                                                                              p,
                                                                              Person::$age),
                                                                  x))
                                                              \then (TRUE)
                                                              \else (FALSE)))
                                                \then (TRUE)
                                                \else (FALSE)),
                               seqSingleton(\if (eventCon(event(p,
                                                                Person#birthday,
                                                                seqEmpty),
                                                          \if (gt(int::select(heap,
                                                                              p,
                                                                              Person::$age),
                                                                  x))
                                                              \then (TRUE)
                                                              \else (FALSE)))
                                                \then (TRUE)
                                                \else (FALSE)))))
}

