\schemaVariables {
    \modalOperator {diamond, box, diamond_transaction, box_transaction} #allmodal;
    \modalOperator {diamond, diamond_transaction} #diamond;
    \modalOperator {box, box_transaction} #box;
    \program SimpleExpression #se, #se0, #se1, #se2;
    \program MethodName #mn;
    \program SimpleExpression #seMn;
    \program [list] SimpleExpression #selist;
    \program [list] Expression #elist;
}

\rules(events:on, programRules:Java, runtimeExceptions:ban) {
  /*! We want to track that a method-call happened and also assign it an eventNr (see event.key). */
  methodCallToEvent {
       \schemaVar \formula post;
       \schemaVar \term Object rp;
       \schemaVar \term MethodName mn;
       \schemaVar \term Seq params;
       \find( ==> \modality{#allmodal}{.. #se.#mn(#selist); ...}\endmodality post)
       \varcond(\not \staticMethodReference(#se, #mn, #selist), \mayExpandMethod(#se, #mn, #selist), \getObject(rp, #se), \getMethodName(mn, #se, #mn, #selist), \getParams(params, #selist))
       "Normal Execution (#se != null)":
           \replacewith( ==> {\eventUpdate(event(rp, mn, params), eventNr)}\modality{#allmodal}{.. #method-call(#se.#mn(#selist)); ...}\endmodality (post));
           //\add( ==> #se = null);
       "Null Reference (#se = null)":
           \replacewith( ==> \modality{#allmodal}{.. throw new java.lang.NullPointerException();
                   ...}\endmodality (post))
           \add(#se = null ==>)
       \heuristics(update_apply)
  };

  applyEventUpdateOnEventCon {
    \schemaVar \term Event evtInUpdate;
    \schemaVar \term int evtNr;
    \schemaVar \term Event evt;
    \schemaVar \term boolean cond;
    \find({\eventUpdate(evtInUpdate, evtNr)}eventCon(evt, cond))
    \sameUpdateLevel
    \replacewith((cond=TRUE & evt=evtInUpdate) | eventCon({\eventUpdate(evtInUpdate, evtNr)}evt, {\eventUpdate(evtInUpdate, evtNr)}cond))
    \heuristics(update_apply)
  };

  applyUpdateOnEventUpdate {
    \schemaVar \update u;
    \schemaVar \term Event evt;
    \schemaVar \term int evtNr;
    \find({u}(\eventUpdate(evt, evtNr)))
    \replacewith(\eventUpdate({u}evt, {u}evtNr))
    \heuristics(update_apply_on_update)
  };

  simplifyEventUpdateOnTerm {
    \schemaVar \update u;
    \schemaVar \term any t;
    \schemaVar \term any result;
    \find({u}t)
    \varcond(\dropEffectlessEventUpdates(u, t, result))
    \replacewith(result)
    \heuristics(update_elim)
  };

  simplifyEventUpdateOnFormula {
    \schemaVar \update u;
    \schemaVar \formula phi, result;
    \find({u}phi)
    \varcond(\dropEffectlessEventUpdates(u, phi, result))
    \replacewith(result)
    \heuristics(update_elim)
 };

  simplifyEventUpdateOnUpdate {
    \schemaVar \update u;
    \schemaVar \update u2;
    \schemaVar \update result;
    \find({u}u2)
    \varcond(\dropEffectlessEventUpdates(u, u2, result))
    \replacewith(result)
    \heuristics(update_elim)
 };

  applyParallelEventUpdateOnEventCon1 {
    \schemaVar \update u;
    \schemaVar \term Event evtInUpdate;
    \schemaVar \term int evtNr;
    \schemaVar \term Event evt;
    \schemaVar \term boolean cond;
    \find({u || \eventUpdate(evtInUpdate, evtNr)}eventCon(evt, cond))
    \replacewith({u}cond=TRUE & {u}evt=evtInUpdate | eventCon({u || \eventUpdate(evtInUpdate, evtNr)}evt, {u || \eventUpdate(evtInUpdate, evtNr)}cond))
    \heuristics(update_apply)
  };

  /* EVENT SEQUENCES */
    applyEventUpdateOnEventSeq {
        \schemaVar \term Seq eventCons;
        \schemaVar \update eventU;
        \find({eventU}eventSeq(eventCons))
        \varcond(\isEventUpdate(eventU))
        \replacewith({eventU}(any::seqGet(eventCons, 0) = TRUE) & eventSeq(seqSub(eventCons, 1, seqLen(eventCons))) | eventSeq(eventCons))
        \heuristics(update_apply)
    };

    eventSeqEmpty {
        \find(eventSeq(seqEmpty))
        \replacewith(true)
        \heuristics(update_elim)
    };

    applyUpdateOnEventCon {
        \schemaVar \update u;
        \schemaVar \term Event e;
        \schemaVar \term boolean c;
        \find({u}eventCon(e, c))
        \varcond(\not \containsEventUpdate(u))
        \replacewith(eventCon({u}e, {u}c))
        \heuristics(update_apply)
    };
    applyUpdateOnEventSeq {
        \schemaVar \update u;
    \schemaVar \term Seq eventCons;
        \find({u}eventSeq(eventCons))
        \varcond(\not \containsEventUpdate(u))
        \replacewith(eventSeq({u}eventCons))
        \heuristics(update_apply)
    };

    applyParallelEventUpdateOnEventCon2 {
        \schemaVar \term Event e;
        \schemaVar \term boolean c;
        \schemaVar \update eventU;
        \schemaVar \update u;
        \find({eventU || u}eventCon(e, c))
        \varcond(\isEventUpdate(eventU), \not \containsEventUpdate(u))
        \replacewith({eventU}eventCon({u}e, {u}c))
        \heuristics(update_apply)
    };

    applyParallelEventUpdateOnEventSeq {
        \schemaVar \term Seq eventCons;
        \schemaVar \term Event e;
        \schemaVar \term boolean c;
        \schemaVar \update eventU;
        \schemaVar \update u;
        \find({eventU || u}eventSeq(eventCons))
        \varcond(\isEventUpdate(eventU), \not \containsEventUpdate(u))
        \replacewith({eventU}eventSeq({u}eventCons))
        \heuristics(update_apply)
    };
}
