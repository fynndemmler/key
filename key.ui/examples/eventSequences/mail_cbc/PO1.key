\javaSource "src/";
\programVariables {
    Client self;
    Client receiver;
    Mail mail;
}

\problem {
        (self != null & receiver != null & mail != null & mail.isEncrypted = TRUE
         -> \<{
                self.decrypt(mail);
              }\> (!eventSeq(seqConcat(seqSingleton(\if(event(Client#decrypt$Mail,
    \if(mail.isEncrypted@heapAtClient#decrypt$Mail=TRUE)\then(TRUE)\else(FALSE)))\then(TRUE)\else(FALSE)),
    seqSingleton(\if(event(Client#send$Client_Mail,
    \if(mail.isEncrypted@heapAtClient#send$Client_Mail=FALSE)\then(TRUE)\else(FALSE)))\then(TRUE)\else(FALSE)))))
        )
}