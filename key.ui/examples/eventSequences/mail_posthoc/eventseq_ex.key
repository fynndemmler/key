\javaSource "src/";

\programVariables {
    Client self;
    Client receiver;
    Mail mail;
}

\rules {
  applyMcUpdateOnSkip {
    \schemaVar \update eu;
    \find({eu}skip)
    \varcond(\isMcUpdate(eu))
    \replacewith(skip)
    \heuristics(concrete) // must be high prio than simplifyOnTerm, else we loop on simplifyOnTerm
  };

  applyUpdateOnMcUpdate {
    \schemaVar \update u;
    \schemaVar \term MethodId mId;
    \find({u}(mcUpdate(mId)))
    \varcond(\not \containsMcUpdate(u)) // TODO: Remove if it should be the same for event updates
    \replacewith(mcUpdate({u}mId))
    \heuristics(update_apply_on_update)
  };

   mcuOnMcu {
        \schemaVar \update mcu1, mcu2;
        \find({mcu1}mcu2)
        \varcond(\isMcUpdate(mcu1), \isMcUpdate(mcu2))
        \replacewith(mcu2)
        \heuristics(update_elim)
    };

    pmcuOnMcu {
        \schemaVar \update mcu1, mcu2, u;
        \find({u || mcu1}mcu2)
        \varcond(\isMcUpdate(mcu1), \isMcUpdate(mcu2))
        \replacewith({u}mcu2)
        \heuristics(update_elim)
    };

    applyChainMcUpdateOnEventCon {
        \schemaVar \term MethodId mIdInUpdate;
        \schemaVar \term MethodId mId;
        \schemaVar \term boolean cond;
        \schemaVar \update eu, u;
        \find({{u}eu}event(mId, cond))
        \varcond(\isMcUpdate(eu))
        \replacewith({u}({eu}(event(mId, cond))) | event({{u}eu}mId, {{u}eu}cond))
        \heuristics(update_apply)
   };

/*
   mpmcuOnEvent {
       \schemaVar \update pu1, pu2;
       \schemaVar \term MethodId mIdInUpdate;
       \schemaVar \term MethodId mId;
       \schemaVar \term boolean cond;
       \find({pu1 || pu2}event(mid, cond))
       \varcond(\containsMcUpdate(pu2))
       \replacewith(({mcUpdate(mIdInUpdate)}cond)=TRUE & ({mcUpdate(mIdInUpdate)}mId)=mIdInUpdate | event({mcUpdate(mIdInUpdate)}mId, {mcUpdate(mIdInUpdate)}cond))
       \heuristics(update_apply)
   };*/

/*
   shiftMCU {
      \schemaVar \update u1, mcu;
      \find(u1 || mcu)
      \varcond(\not \isMcUpdate(u1), \isMcUpdate(mcu))
      \replacewith(mcu || u1)
      \heuristics(update_apply)
   };*/

   associativeMcu {
      \schemaVar \update u1, u2, mcu;
      \find(u1 || (u2 || mcu))
      \varcond(\isMcUpdate(mcu))
      \replacewith(u1 || u2 || mcu)
      \heuristics(update_apply)
   };

}

\problem {
        (self != null & receiver != null & mail != null & mail.isEncrypted = TRUE
         -> \<{
                self.decrypt(mail);
                mail.isEncrypted = true;
                self.addToInbox(mail);
                self.send(receiver, mail);
              }\> (!eventSeq(seqConcat(seqSingleton(\if(event(Client#decrypt$Mail, \if(mail.isEncrypted@heapAtClient#decrypt$Mail=TRUE)\then(TRUE)\else(FALSE)))\then(TRUE)\else(FALSE)), seqSingleton(\if(event(Client#send$Client_Mail, \if(mail.isEncrypted@heapAtClient#send$Client_Mail=FALSE)\then(TRUE)\else(FALSE)))\then(TRUE)\else(FALSE))))))
}
