\javaSource "src/";

// The program variables must be unique and non-reusable/aliasable
// Need slides about how we generate this stuff, need knowledge of:

\programVariables {
    Client self;
    Client receiver;
    Mail mail;
    boolean condAtClient_decrypt_Mail; // [GENERATED]
    boolean condAtClient_send_Client_Mail; // [GENERATED]
}

/*\rules {
    chainMcuOnE {
        \schemaVar \update u, mcu;
        \find({u}
    };
}*/


\problem {
        (self != null & receiver != null & mail != null & mail.isEncrypted = TRUE
         -> \<{
                condAtClient_decrypt_Mail = mail.isEncrypted == true; // [GENERATED]
                self.decrypt(mail);
                mail.isEncrypted = true;
                self.addToInbox(mail);
                condAtClient_send_Client_Mail = mail.isEncrypted == false; // [GENERATED]
                self.send(receiver, mail);
              }\> (!eventSeq(seqConcat(seqSingleton(\if(event(Client#send$Client_Mail, condAtClient_send_Client_Mail))\then(TRUE)\else(FALSE)), seqSingleton(\if(event(Client#decrypt$Mail, condAtClient_decrypt_Mail))\then(TRUE)\else(FALSE))))))
}

