\schemaVariables {
    \modalOperator {diamond, box, diamond_transaction, box_transaction} #allmodal;
    \modalOperator {diamond, diamond_transaction} #diamond;
    \modalOperator {box, box_transaction} #box;
    \program SimpleExpression #se, #se0, #se1, #se2;
    \program MethodName #mn;
    \program SimpleExpression #seMn;
    \program [list] SimpleExpression #selist;
    \program [list] Expression #elist;
}

\rules(events:on, programRules:Java, runtimeExceptions:ban) {
  methodCallToEvent {
       \schemaVar \formula post;
       \schemaVar \term Object rp;
       \schemaVar \term MethodId mId;
       \schemaVar \program Variable #heapAtmId;
       \schemaVar \term Seq params;
       \find( ==> \modality{#allmodal}{.. #se.#mn(#selist); ...}\endmodality post)
       \varcond(\not \staticMethodReference(#se, #mn, #selist), \mayExpandMethod(#se, #mn, #selist), \getMethodIdentifier(mId, #se, #mn, #selist), \getMethodHeap(#heapAtmId, mId))
       "Normal Execution (#se != null)":
           \replacewith( ==> {#heapAtmId := heap || \eventUpdate(mId)}\modality{#allmodal}{.. #method-call(#se.#mn(#selist)); ...}\endmodality (post));
           //\add( ==> #se = null);
       "Null Reference (#se = null)":
           \replacewith( ==> \modality{#allmodal}{.. throw new java.lang.NullPointerException();
                   ...}\endmodality (post))
           \add(#se = null ==>)
       \heuristics(update_apply)
  };

  applyEventUpdateOnEventCon {
      \schemaVar \term MethodId mIdInUpdate;
      \schemaVar \term MethodId mId;
      \schemaVar \term boolean cond;
      \find({\eventUpdate(mIdInUpdate)}event(mId, cond))
      \sameUpdateLevel
      \replacewith((cond=TRUE & mId=mIdInUpdate) | event({\eventUpdate(mIdInUpdate)}mId, {\eventUpdate(mIdInUpdate)}cond))
      //;\replacewith(({\eventUpdate(mIdInUpdate)}cond)=TRUE & ({\eventUpdate(mIdInUpdate)}mId)=mIdInUpdate | event({\eventUpdate(mIdInUpdate)}mId, {\eventUpdate(mIdInUpdate)}cond))
      \heuristics(update_apply)
    };

/*
  applyEventUpdateOnEventCon_NEW_ONE_REPLACE {
      \schemaVar \term MethodId mIdInUpdate;
      \schemaVar \term MethodId mId;
      \schemaVar \term boolean cond;
      \find({\eventUpdate(mIdInUpdate)}event(mId, cond))
      \sameUpdateLevel
      \replacewith(({\eventUpdate(mIdInUpdate)}cond)=TRUE & ({\eventUpdate(mIdInUpdate)}mId)=mIdInUpdate | event({\eventUpdate(mIdInUpdate)}mId, {\eventUpdate(mIdInUpdate)}cond))
      \heuristics(update_apply)
    };*/

/*
  applyEventUpdateOnEventCon_OLD {
    \schemaVar \term MethodId mIdInUpdate;
    \schemaVar \term MethodId mId;
    \schemaVar \term boolean cond;
    \find({\eventUpdate(mIdInUpdate)}event(mId, cond))
    \sameUpdateLevel
    \replacewith((cond=TRUE & mId=mIdInUpdate) | event({\eventUpdate(mIdInUpdate)}mId, {\eventUpdate(mIdInUpdate)}cond))
    \heuristics(update_apply)
  };*/


  simplifyEventUpdateOnMethodId {
    \schemaVar \update eu;
    \schemaVar \term MethodId mId;
    \find({eu}mId)
    \varcond(\isEventUpdate(eu))
    \replacewith(mId)
    \heuristics(update_elim)
  };

/* New */
  simplifyParallelEventUpdateOnMethodId {
    \schemaVar \update eu;
    \schemaVar \update u;
    \schemaVar \term MethodId mId;
    \find({u || eu}mId)
    \varcond(\isEventUpdate(eu))
    \replacewith({u}mId)
    \heuristics(update_elim)
  };

  simplifyParallelEventUpdateOnMethodId2 {
      \schemaVar \update eu;
      \schemaVar \update u;
      \schemaVar \term MethodId mId;
      \find({eu || u}mId)
      \varcond(\isEventUpdate(eu))
      \replacewith({u}mId)
      \heuristics(update_elim)
  };

  simplifyChainEventUpdateOnMethodId {
      \schemaVar \update eu;
      \schemaVar \update u;
      \schemaVar \term MethodId mId;
      \find({{u}eu}mId)
      \varcond(\isEventUpdate(eu))
      \replacewith({u}mId)
      \heuristics(update_elim)
    };

 /* END NEW */

  simplifyEventUpdateOnTerm {
    \schemaVar \update u;
    \schemaVar \term any t;
    \schemaVar \term any result;
    \find({u}t)
    \varcond(\dropEffectlessEventUpdates(u, t, result))
    \replacewith(result)
    \heuristics(update_elim)
  };

  simplifyEventUpdateOnFormula {
    \schemaVar \update u;
    \schemaVar \formula phi, result;
    \find({u}phi)
    \varcond(\dropEffectlessEventUpdates(u, phi, result))
    \replacewith(result)
    \heuristics(update_elim)
 };

simplifyEventUpdateOnEventUpdate {
    \schemaVar \update eu1;
    \schemaVar \update eu2;
    \find({eu1}eu2)
    \varcond(\isEventUpdate(eu1), \isEventUpdate(eu2))
    \replacewith(eu2)
};
/* TODO: REmove comment once checked
  simplifyEventUpdateOnUpdate {
    \schemaVar \update u;
    \schemaVar \update u2;
    \schemaVar \update result;
    \find({u}u2)
    \varcond(\dropEffectlessEventUpdates(u, u2, result))
    \replacewith(result)
    \heuristics(update_elim)
 };*/

  applyParallelEventUpdateOnEventCon1 { // TODO this rule and the non-parallel rule need to be changed since they apply the newest method call not the oldest.
    \schemaVar \update u;
    \schemaVar \term MethodId mIdInUpdate;
    \schemaVar \term MethodId mId;
    \schemaVar \term boolean cond;
    \find({u || \eventUpdate(mIdInUpdate)}event(mId, cond))
    \replacewith({u}cond=TRUE & {u}mId=mIdInUpdate | event({u || \eventUpdate(mIdInUpdate)}mId, {u || \eventUpdate(mIdInUpdate)}cond))
    //;\replacewith({u || \eventUpdate(mIdInUpdate)}cond=TRUE & {u || \eventUpdate(mIdInUpdate)}mId=mIdInUpdate | event({u || \eventUpdate(mIdInUpdate)}mId, {u || \eventUpdate(mIdInUpdate)}cond))
    \heuristics(update_apply)
  };

  /* EVENT SEQUENCES */
      applyEventUpdateOnEventSeq {
          \schemaVar \term Seq events;
          \schemaVar \update eventU;
          \find({eventU}eventSeq(events))
          \varcond(\isEventUpdate(eventU))
                  \replacewith({eventU}(boolean::seqGet(events, 0) = seqEmpty | ((seqLen(events) >= 1 -> (boolean::seqGet(events, 0) = TRUE)) & (seqLen(events) > 1 -> eventSeq(seqSub(events, 1, seqLen(events)))))))
          \heuristics(update_apply)
      };

/*
      applyEventUpdateOnEventSeq2 {
          \schemaVar \term Seq events;
          \schemaVar \update eventU;
          \find({eventU}eventSeq(events))
          \varcond(\isEventUpdate(eventU))
          \replacewith({eventU}(boolean::seqGet(events, 0) = seqEmpty | (seqLen(events) = 1 -> (boolean::seqGet(events, 0) = TRUE)) | (seqLen(events) > 1 -> eventSeq(seqSub(events, 1, seqLen(events))))))
          \heuristics(update_apply)
      };*/

/*
    applyEventUpdateOnEventSeq_OLD {
        \schemaVar \term Seq events;
        \schemaVar \update eventU;
        \find({eventU}eventSeq(events))
        \varcond(\isEventUpdate(eventU))
        \replacewith({eventU}(boolean::seqGet(events, 0) = seqEmpty | (boolean::seqGet(events, 0) = TRUE) & eventSeq(seqSub(events, 1, seqLen(events)))) | eventSeq(events))
        \heuristics(update_apply)
    };*/

    eventSeqEmpty {
        \find(eventSeq(seqEmpty))
        \replacewith(true)
        \heuristics(update_elim)
    };

    applyUpdateOnEventCon {
        \schemaVar \update u;
        \schemaVar \term MethodId mId;
        \schemaVar \term boolean c;
        \find({u}event(mId, c))
        \varcond(\not \containsEventUpdate(u))
        \replacewith(event({u}mId, {u}c))
        \heuristics(update_apply)
    };
    applyUpdateOnEventSeq {
        \schemaVar \update u;
        \schemaVar \term Seq events;
        \find({u}eventSeq(events))
        \varcond(\not \containsEventUpdate(u))
        \replacewith(eventSeq({u}events))
        \heuristics(update_apply)
    };

    applyParallelEventUpdateOnEventCon2 {
        \schemaVar \term MethodId mId;
        \schemaVar \term boolean c;
        \schemaVar \update eventU;
        \schemaVar \update u;
        \find({eventU || u}event(mId, c))
        \varcond(\isEventUpdate(eventU), \not \containsEventUpdate(u))
        \replacewith({eventU}event({u}mId, {u}c))
        \heuristics(update_apply)
    };

    applyParallelEventUpdateOnEventSeq2 {
        \schemaVar \term Seq events;
        \schemaVar \update eventU;
        \schemaVar \update u;
        \find({u || eventU}eventSeq(events))
        \varcond(\isEventUpdate(eventU))
        \replacewith({eventU}eventSeq({u}events))
        \heuristics(update_apply)
    };

    applyParallelEventUpdateOnEventSeq {
        \schemaVar \term Seq events;
        \schemaVar \update eventU;
        \schemaVar \update u;
        \find({eventU || u}eventSeq(events))
        \varcond(\isEventUpdate(eventU), \not \containsEventUpdate(u))
        \replacewith({eventU}eventSeq({u}events))
        \heuristics(update_apply)
    };

    simplifyFalseEvent {
        \schemaVar \term MethodId mid;
        \schemaVar \term boolean c;
        \schemaVar \term Seq events;
        \find(event(mid, FALSE))
        \replacewith(false)
        \heuristics(concrete)
    };
}
