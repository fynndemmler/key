\javaSource "src/";

\programVariables {
    Client self;
    Client receiver;
    Mail mail;
    int j;
}

\rules {
  applyUpdateOnEventUpdate {
    \schemaVar \update u;
    \schemaVar \term MethodId mId;
    \find({u}(\eventUpdate(mId)))
    //\varcond(\not \isEventUpdate(u)) // TODO: Remove if it should be the same for event updates
    \replacewith(\eventUpdate({u}mId))
    \heuristics(update_apply_on_update)
  };
/*
  shiftParallelUpdateOnEventSeqTEEEEEEEEEEEEEEEEEEESSSSSSSSSSSSSSTTTTTTTTTTT {
    \schemaVar \update u1, u2, eu;
    \schemaVar \term Seq events;
    \find({u1 || eu || u2}eventSeq(events))
    \varcond(\isEventUpdate(eu))
    \replacewith({u1 || u2 || eu}eventSeq(events))
    \heuristics(update_apply)
  };*/


/*applyParallelEventUpdateOnEventSeq {
    \schemaVar \term Seq events;
    \schemaVar \update u, eventU;
    \find({u || eventU}eventSeq(events))
    \varcond(\isEventUpdate(eventU))
            \replacewith({u || eventU}(seqEmpty = events | ((seqLen(events) >= 1 -> (boolean::seqGet(events, 0) = TRUE)) & (seqLen(events) > 1 -> eventSeq(seqSub(events, 1, seqLen(events)))))))
    \heuristics(update_apply)
};*/

/*
applyParallelEventUpdateOnEventSeq {
    \schemaVar \term Seq events;
    \schemaVar \update u, u2;
    \find({u || u2}eventSeq(events))
    \replacewith({u || u2}(boolean::seqGet(events, 0) = seqEmpty | ((seqLen(events) >= 1 -> (boolean::seqGet(events, 0) = TRUE)) & (seqLen(events) > 1 -> eventSeq(seqSub(events, 1, seqLen(events)))))))
    \heuristics(update_apply)
};*/
applyParallelEventUpdateOnEventSeq {
    \schemaVar \term Seq events;
    \schemaVar \update u, u2;
    \find({u || u2}eventSeq(events))
    \replacewith({u || u2}(boolean::seqGet(events, 0) = seqEmpty | (seqLen(events) = 1 -> (boolean::seqGet(events, 0) = TRUE)) | (seqLen(events) > 1 -> eventSeq(seqSub(events, 1, seqLen(events))))))
    \heuristics(update_apply)
};

shiftEU1 {
    \schemaVar \update eu, u;
    \schemaVar \program Variable pv;
    \schemaVar \program Variable pv2;
    \schemaVar \term any t;
    \find(eu || u)
    \varcond(\isEventUpdate(eu))
    \replacewith(u || eu)
    \heuristics(update_apply)
};

shiftEU2 {
    \schemaVar \update eu, u;
    \schemaVar \program Variable pv;
    \schemaVar \term any t;
    \find(eu || pv:=t || u)
    \varcond(\isEventUpdate(eu))
    \replacewith(pv:=t || eu || u)
    \heuristics(update_apply)
};
}

\problem {
        (self != null & receiver != null & mail != null & mail.isEncrypted = TRUE
         -> \<{
                int i = 0;
                self.decrypt(mail);
                self.send(receiver, mail);
                j = i + 2;
              }\> (j = 2 & mail.isEncrypted = FALSE & (event(Client#decrypt$Mail, \if(mail.isEncrypted@heapAtClient#decrypt$Mail=TRUE)\then(TRUE)\else(FALSE)) -> event(Client#send$Client_Mail, \if(mail.isEncrypted@heapAtClient#send$Client_Mail=FALSE)\then(TRUE)\else(FALSE)))))
}
