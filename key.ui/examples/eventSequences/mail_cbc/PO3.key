\javaSource "src/";

\programVariables {
    Client self;
    Client receiver;
    Mail mail;
}

\problem {
        (self != null & receiver != null & mail != null & mail.isEncrypted = FALSE
         -> \<{
                self.send(receiver, mail);
              }\>
              (!eventSeq(seqSingleton(\if(event(Client#send$Client_Mail, \if(mail.isEncrypted@heapAtClient#send$Client_Mail=FALSE)\then(TRUE)\else(FALSE)))\then(TRUE)\else(FALSE)))))
}