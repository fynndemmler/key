\schemaVariables {
    \modalOperator {diamond, box, diamond_transaction, box_transaction} #allmodal;
    \modalOperator {diamond, diamond_transaction} #diamond;
    \modalOperator {box, box_transaction} #box;
    \program SimpleExpression #se, #se0, #se1, #se2;
    \program MethodName #mn;
    \program SimpleExpression #seMn;
    \program [list] SimpleExpression #selist;
    \program [list] Expression #elist;
}

\rules(events:on, programRules:Java, runtimeExceptions:ban) {
    /*=================*/
    /*      EVENTS     */
    /*=================*/
    methodCall { // in thesis
       \schemaVar \formula post;
       \schemaVar \term Object rp;
       \schemaVar \term MethodId mId;
       \schemaVar \program Variable #heapAtmId;
       \schemaVar \term Seq params;
       \find( ==> \modality{#allmodal}{.. #se.#mn(#selist); ...}\endmodality post)
       \varcond(\not \staticMethodReference(#se, #mn, #selist), \mayExpandMethod(#se, #mn, #selist), \getMethodIdentifier(mId, #se, #mn, #selist), \getMethodHeap(#heapAtmId, mId))
       "Normal Execution (#se != null)":
           \replacewith( ==> {#heapAtmId := heap || mcUpdate(mId)}\modality{#allmodal}{.. #method-call(#se.#mn(#selist)); ...}\endmodality (post));
           //\add( ==> #se = null);
       "Null Reference (#se = null)":
           \replacewith( ==> \modality{#allmodal}{.. throw new java.lang.NullPointerException();
                   ...}\endmodality (post))
           \add(#se = null ==>)
       \heuristics(update_apply)
    };

    MCUonE { // in thesis
        \schemaVar \term MethodId mIdInUpdate;
        \schemaVar \term MethodId mId;
        \schemaVar \term boolean cond;
        \find({mcUpdate(mIdInUpdate)}event(mId, cond))
        \sameUpdateLevel
        \replacewith(({mcUpdate(mIdInUpdate)}cond)=TRUE & ({mcUpdate(mIdInUpdate)}mId)=mIdInUpdate | event({mcUpdate(mIdInUpdate)}mId, {mcUpdate(mIdInUpdate)}cond))
        \heuristics(update_elim)
    };

    simplifyMCUonMID {
        \schemaVar \update eu;
        \schemaVar \term MethodId mId;
        \find({eu}mId)
        \varcond(\isMcUpdate(eu))
        \replacewith(mId)
        \heuristics(update_elim)
    };

    simplifyPMCUonMID {
        \schemaVar \update eu;
        \schemaVar \update u;
        \schemaVar \term MethodId mId;
        \find({u || eu}mId)
        \varcond(\isMcUpdate(eu))
        \replacewith({u}mId)
        \heuristics(update_elim)
    };

    simplifyPMCUonMID2 {
        \schemaVar \update eu;
        \schemaVar \update u;
        \schemaVar \term MethodId mId;
        \find({eu || u}mId)
        \varcond(\isMcUpdate(eu))
        \replacewith({u}mId)
        \heuristics(update_elim)
    };

    simplifyChainMcUpdateOnMethodId {
        \schemaVar \update eu;
        \schemaVar \update u;
        \schemaVar \term MethodId mId;
        \find({{u}eu}mId)
        \varcond(\isMcUpdate(eu))
        \replacewith({u}mId)
        \heuristics(update_elim)
    };

    simplifyMCUonTerm { // in thesis
        \schemaVar \update u;
        \schemaVar \term any t;
        \schemaVar \term any result;
        \find({u}t)
        \varcond(\dropEffectlessMcUpdates(u, t, result))
        \replacewith(result)
        \heuristics(update_elim)
    };

    simplifyMCUonFormula { // in thesis
        \schemaVar \update u;
        \schemaVar \formula phi, result;
        \find({u}phi)
        \varcond(\dropEffectlessMcUpdates(u, phi, result))
        \replacewith(result)
        \heuristics(update_elim)
    };

    /* TODO: REmove comment once checked
    simplifyMcUpdateOnMcUpdate {
        \schemaVar \update eu1;
        \schemaVar \update eu2;
        \find({eu1}eu2)
        \varcond(\isMcUpdate(eu1), \isMcUpdate(eu2))
        \replacewith(eu2)
    };

    simplifyMcUpdateOnUpdate {
        \schemaVar \update u;
        \schemaVar \update u2;
        \schemaVar \update result;
        \find({u}u2)
        \varcond(\dropEffectlessMcUpdates(u, u2, result))
        \replacewith(result)
        \heuristics(update_elim)
    };*/

    pMCUonE1 { // in thesis
        \schemaVar \update u;
        \schemaVar \term MethodId mIdInUpdate;
        \schemaVar \term MethodId mId;
        \schemaVar \term boolean cond;
        \find({u || mcUpdate(mIdInUpdate)}event(mId, cond))
        \replacewith({u || mcUpdate(mIdInUpdate)}cond=TRUE & {u || mcUpdate(mIdInUpdate)}mId=mIdInUpdate | event({u || mcUpdate(mIdInUpdate)}mId, {u || mcUpdate(mIdInUpdate)}cond))
        \heuristics(update_apply)
    };

    pMCUonE2 { // in thesis
        \schemaVar \term MethodId mId;
        \schemaVar \term boolean c;
        \schemaVar \update eventU;
        \schemaVar \update u;
        \find({eventU || u}event(mId, c))
        \varcond(\isMcUpdate(eventU), \not \containsMcUpdate(u))
        \replacewith({eventU}event({u}mId, {u}c))
        \heuristics(update_apply)
    };

    NUonE {
        \schemaVar \update u;
        \schemaVar \term MethodId mId;
        \schemaVar \term boolean c;
        \find({u}event(mId, c))
        \varcond(\not \containsMcUpdate(u))
        \replacewith(event({u}mId, {u}c))
        \heuristics(update_apply)
    };

    elimFalseE {
        \schemaVar \term MethodId mid;
        \find(event(mid, FALSE))
        \replacewith(false)
        \heuristics(concrete)
    };

    /* By definition, an event can only be true if there exists a suitable method call. Therefore, any event not bound
     by a modality or update is false in the succedent and by contradiction in the antecedent.*/
    elimIsolE1 {
        \schemaVar \term MethodId mid;
        \schemaVar \term boolean c;
        \find(event(mid, c) ==>)
        \inSequentState
        \replacewith(false ==>)
        \heuristics(concrete)
    };

    elimIsolatedEvent2 {
        \schemaVar \term MethodId mid;
        \schemaVar \term boolean c;
        \find(==> event(mid, c))
        \inSequentState
        \replacewith(==> false)
        \heuristics(concrete)
    };

    /*=================*/
    /* EVENT SEQUENCES */
    /*=================*/

    MCUonES { // in thesis
      \schemaVar \term Seq events;
      \schemaVar \update eventU;
      \find({eventU}eventSeq(events))
      \varcond(\isMcUpdate(eventU))
      \replacewith({eventU}(boolean::seqGet(events, 0) = seqEmpty | ((seqLen(events) >= 1 -> (boolean::seqGet(events, 0) = TRUE)) & (seqLen(events) > 1 -> eventSeq(seqSub(events, 1, seqLen(events)))))))
      \heuristics(update_apply)
    };

    emptyES {
        \find(eventSeq(seqEmpty))
        \replacewith(true)
        \heuristics(update_elim)
    };

    NUonES {
        \schemaVar \update u;
        \schemaVar \term Seq events;
        \find({u}eventSeq(events))
        \varcond(\not \containsMcUpdate(u))
        \replacewith(eventSeq({u}events))
        \heuristics(update_apply)
    };

    pMCUonES1 { // in thesis
        \schemaVar \term Seq events;
        \schemaVar \update eventU;
        \schemaVar \update u;
        \find({eventU || u}eventSeq(events))
        \varcond(\isMcUpdate(eventU), \not \containsMcUpdate(u))
        \replacewith({eventU}eventSeq({u}events))
        \heuristics(update_apply)
    };

    pMCUonES2 {
        \schemaVar \term Seq events;
        \schemaVar \update eventU;
        \schemaVar \update u;
        \find({u || eventU}eventSeq(events))
        \varcond(\isMcUpdate(eventU))
        \replacewith({eventU}eventSeq({u}events))
        \heuristics(update_apply)
    };
}
