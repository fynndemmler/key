\schemaVariables {
    \modalOperator {diamond, box, diamond_transaction, box_transaction} #allmodal;
    \modalOperator {diamond, diamond_transaction} #diamond;
    \modalOperator {box, box_transaction} #box;
    \program SimpleExpression #se, #se0, #se1, #se2;
    \program MethodName #mn;
    \program SimpleExpression #seMn;
    \program [list] SimpleExpression #selist;
    \program [list] Expression #elist;
}

\rules(events:on, programRules:Java, runtimeExceptions:ban) {
  methodCallToEvent {
       \schemaVar \formula post;
       \schemaVar \term Object rp;
       \schemaVar \term MethodId mId;
       \schemaVar \term Seq params;
       \find( ==> \modality{#allmodal}{.. #se.#mn(#selist); ...}\endmodality post)
       \varcond(\not \staticMethodReference(#se, #mn, #selist), \mayExpandMethod(#se, #mn, #selist), \getMethodIdentifier(mId, #se, #mn, #selist))
       "Normal Execution (#se != null)":
           \replacewith( ==> {\eventUpdate(mId)}\modality{#allmodal}{.. #method-call(#se.#mn(#selist)); ...}\endmodality (post));
           //\add( ==> #se = null);
       "Null Reference (#se = null)":
           \replacewith( ==> \modality{#allmodal}{.. throw new java.lang.NullPointerException();
                   ...}\endmodality (post))
           \add(#se = null ==>)
       \heuristics(update_apply)
  };

  applyEventUpdateOnEventCon {
    \schemaVar \term MethodId mIdInUpdate;
    \schemaVar \term MethodId mId;
    \schemaVar \term boolean cond;
    \find({\eventUpdate(mIdInUpdate)}event(mId, cond))
    \sameUpdateLevel
    \replacewith((cond=TRUE & mId=mIdInUpdate) | event({\eventUpdate(mIdInUpdate)}mId, {\eventUpdate(mIdInUpdate)}cond))
    \heuristics(update_apply)
  };

  applyUpdateOnEventUpdate {
    \schemaVar \update u;
    \schemaVar \term MethodId mId;
    \find({u}(\eventUpdate(mId)))
    \replacewith(\eventUpdate({u}mId))
    \heuristics(update_apply_on_update)
  };

  simplifyEventUpdateOnTerm {
    \schemaVar \update u;
    \schemaVar \term any t;
    \schemaVar \term any result;
    \find({u}t)
    \varcond(\dropEffectlessEventUpdates(u, t, result))
    \replacewith(result)
    \heuristics(update_elim)
  };

  simplifyEventUpdateOnFormula {
    \schemaVar \update u;
    \schemaVar \formula phi, result;
    \find({u}phi)
    \varcond(\dropEffectlessEventUpdates(u, phi, result))
    \replacewith(result)
    \heuristics(update_elim)
 };

  simplifyEventUpdateOnUpdate {
    \schemaVar \update u;
    \schemaVar \update u2;
    \schemaVar \update result;
    \find({u}u2)
    \varcond(\dropEffectlessEventUpdates(u, u2, result))
    \replacewith(result)
    \heuristics(update_elim)
 };

  applyParallelEventUpdateOnEventCon1 {
    \schemaVar \update u;
    \schemaVar \term MethodId mIdInUpdate;
    \schemaVar \term MethodId mId;
    \schemaVar \term boolean cond;
    \find({u || \eventUpdate(mIdInUpdate)}event(mId, cond))
    \replacewith({u}cond=TRUE & {u}mId=mIdInUpdate | event({u || \eventUpdate(mIdInUpdate)}mId, {u || \eventUpdate(mIdInUpdate)}cond))
    \heuristics(update_apply)
  };

  /* EVENT SEQUENCES */
    applyEventUpdateOnEventSeq {
        \schemaVar \term Seq events;
        \schemaVar \update eventU;
        \find({eventU}eventSeq(events))
        \varcond(\isEventUpdate(eventU))
        \replacewith({eventU}(any::seqGet(events, 0) = TRUE) & eventSeq(seqSub(events, 1, seqLen(events))) | eventSeq(events))
        \heuristics(update_apply)
    };

    eventSeqEmpty {
        \find(eventSeq(seqEmpty))
        \replacewith(true)
        \heuristics(update_elim)
    };

    applyUpdateOnEventCon {
        \schemaVar \update u;
        \schemaVar \term MethodId mId;
        \schemaVar \term boolean c;
        \find({u}event(mId, c))
        \varcond(\not \containsEventUpdate(u))
        \replacewith(event({u}mId, {u}c))
        \heuristics(update_apply)
    };
    applyUpdateOnEventSeq {
        \schemaVar \update u;
        \schemaVar \term Seq events;
        \find({u}eventSeq(events))
        \varcond(\not \containsEventUpdate(u))
        \replacewith(eventSeq({u}events))
        \heuristics(update_apply)
    };

    applyParallelEventUpdateOnEventCon2 {
        \schemaVar \term MethodId mId;
        \schemaVar \term boolean c;
        \schemaVar \update eventU;
        \schemaVar \update u;
        \find({eventU || u}event(mId, c))
        \varcond(\isEventUpdate(eventU), \not \containsEventUpdate(u))
        \replacewith({eventU}event({u}mId, {u}c))
        \heuristics(update_apply)
    };

    applyParallelEventUpdateOnEventSeq {
        \schemaVar \term Seq events;
        \schemaVar \update eventU;
        \schemaVar \update u;
        \find({eventU || u}eventSeq(events))
        \varcond(\isEventUpdate(eventU), \not \containsEventUpdate(u))
        \replacewith({eventU}eventSeq({u}events))
        \heuristics(update_apply)
    };
}
