\javaSource "src/";

\programVariables {
    Client self;
    Client receiver;
    Mail mail;
    int j;
}

\problem {
        (self != null & receiver != null & mail != null & mail.isEncrypted = FALSE
         -> \<{
                int i = 0;
                mail.isEncrypted = true;
                self.decrypt(mail);
                j = i + 2;
              }\> (j = 2 & mail.isEncrypted = FALSE & event(Client#decrypt$Mail, \if(mail.isEncrypted@heapAtClient#decrypt$Mail=TRUE)\then(TRUE)\else(FALSE))))
}
