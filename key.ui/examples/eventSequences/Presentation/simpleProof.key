\javaSource "../methodExample/"; // location of class definitions

\programVariables {
  Person p;
  int x;
}

\problem {
        {p.age:=18}
        (x = 18 & p != null
         -> \<{
                p.birthday();
              }\> (eventSeq(seqSingleton(\if(eventCon(event(p, Person#birthday, seqEmpty), \if(p.age > x)\then(TRUE)\else(FALSE)))\then(TRUE)\else(FALSE)))))
}











