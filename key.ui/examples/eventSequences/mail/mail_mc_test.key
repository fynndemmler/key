\javaSource "src/";

\programVariables {
    Client self;
    Client receiver;
    Mail mail;
}

\problem {
        (self != null & receiver != null & mail != null & mail.isEncrypted = TRUE
         -> \<{
                self.decrypt(mail);
              }\> (!eventSeq(seqSingleton(\if(event(Client#decrypt$Mail, \if(mail.isEncrypted=TRUE)\then(TRUE)\else(FALSE)))\then(TRUE)\else(FALSE)))))
}