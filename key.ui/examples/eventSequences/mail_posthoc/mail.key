    mcuOnHeapAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA {
        \schemaVar \term MethodId mid;
        \schemaVar \term Heap h, mcHeap;
        \find({mcUpdate(mid, mcHeap)}h)
        \replacewith(mcHeap)
        \heuristics(concrete)
    };

    pMcuOnHeapBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB {
        \schemaVar \term MethodId mid;
        \schemaVar \update u;
