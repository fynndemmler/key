\javaSource "src/";

\programVariables {
    Client self;
    Client receiver;
    Mail mail;
    boolean condAtClient#decrypt#Mail1;
    boolean condAtClient#send#Client_Mail1;
}

\problem {
        (self != null & receiver != null & mail != null & mail.isEncrypted = TRUE
         -> \<{
                condAtClient#decrypt#Mail1 = mail.isEncrypted == true; // [GENERATED]
                self.decrypt(mail);
                mail.isEncrypted = true;
                self.addToInbox(mail);
                condAtClient#send#Client_Mail1 = mail.isEncrypted == false; // [GENERATED]
                self.send(receiver, mail);
              }\> (!eventSeq(seqConcat(seqSingleton(\if(event(Client#decrypt$Mail, condAtClient#decrypt#Mail1))\then(TRUE)\else(FALSE)), seqSingleton(\if(event(Client#send$Client_Mail, condAtClient#send#Client_Mail1))\then(TRUE)\else(FALSE))))))
}

