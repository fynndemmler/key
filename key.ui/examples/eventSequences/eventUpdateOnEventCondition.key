\problem {
          {eventNr:=0} /* Declaration in 'event.key', this has to be used when events are argue about temporal
          properties, e.g. event1 happens before event2. */
          {p.age:=2} // assign initial value to 'age'
            (   x = 0 & p != null
             -> \<{
                    p.birthday();
                    // age = 3
                    p.birthday();
                    // age = 4
                  }\> (p.age > x & eventCon(event(p, Person#birthday, seqEmpty), \if(p.age + 1 > x)\then(TRUE)\else(FALSE))))
          // assumption: Only single statements
// (p.age > x & eventCon(event(p, Person#birthday, seqEmpty), \if(p.age > x)\then(TRUE)\else(FALSE))))
// (p.age > x & eventCon(event(p, Person#birthday, seqEmpty), \if(p.age=3)\then(TRUE)\else(FALSE)) & eventCon(event(p, Person#birthday, seqEmpty), \if(p.age=4)\then(TRUE)\else(FALSE)))
//eventSeq(ec1
}
