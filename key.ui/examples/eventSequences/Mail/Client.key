\rules {
    MCUonEright {
        \schemaVar \term MethodId mIdInUpdate;
        \schemaVar \term MethodId mId;
        \schemaVar \term boolean cond;
        \find(==>{mcUpdate(mIdInUpdate)}event(mId, cond))
        \sameUpdateLevel
        "event TRUE":
            \replacewith(==>({mcUpdate(mIdInUpdate)}cond)=TRUE & ({mcUpdate(mIdInUpdate)}mId)=mIdInUpdate);
        "event FALSE":
            \replacewith(==>event({mcUpdate(mIdInUpdate)}mId, {mcUpdate(mIdInUpdate)}cond))
            \add(cond=FALSE | mId != mIdInUpdate ==>)
        \heuristics(update_apply)
    };

    MCUonEleft {
        \schemaVar \term MethodId mIdInUpdate;
        \schemaVar \term MethodId mId;
        \schemaVar \term boolean cond;
        \find({mcUpdate(mIdInUpdate)}event(mId, cond)==>)
        \sameUpdateLevel
        "event TRUE":
            \replacewith(({mcUpdate(mIdInUpdate)}cond)=TRUE & ({mcUpdate(mIdInUpdate)}mId)=mIdInUpdate ==>);
        "event FALSE":
            \replacewith(event({mcUpdate(mIdInUpdate)}mId, {mcUpdate(mIdInUpdate)}cond)==>)
            \add(cond=FALSE | mId != mIdInUpdate ==>)
        \heuristics(update_apply)
    };

    pMCUonEleft {
        \schemaVar \update u;
        \schemaVar \term MethodId mIdInUpdate;
        \schemaVar \term MethodId mId;
        \schemaVar \term boolean cond;
        \find({u || mcUpdate(mIdInUpdate)}event(mId, cond) ==>)
        \sameUpdateLevel
        "event TRUE":
            \replacewith({u || mcUpdate(mIdInUpdate)}cond=TRUE & {u || mcUpdate(mIdInUpdate)}mId=mIdInUpdate ==>);
        "event FALSE":
            \replacewith({u || mcUpdate(mIdInUpdate)}cond=TRUE & {u || mcUpdate(mIdInUpdate)}mId=mIdInUpdate ==>)
            \add(cond=FALSE | mId != mIdInUpdate ==>)
        \heuristics(update_apply)
    };

    pMCUonEright {
        \schemaVar \update u;
        \schemaVar \term MethodId mIdInUpdate;
        \schemaVar \term MethodId mId;
        \schemaVar \term boolean cond;
        \find(==>{u || mcUpdate(mIdInUpdate)}event(mId, cond))
        \sameUpdateLevel
        "event TRUE":
            \replacewith( ==>{u || mcUpdate(mIdInUpdate)}cond=TRUE & {u || mcUpdate(mIdInUpdate)}mId=mIdInUpdate);
        "event FALSE":
            \replacewith(==>{u || mcUpdate(mIdInUpdate)}cond=TRUE & {u || mcUpdate(mIdInUpdate)}mId=mIdInUpdate)
            \add(cond=FALSE | mId != mIdInUpdate ==>)
        \heuristics(update_apply)
    };
}
\javaSource "src";
\chooseContract