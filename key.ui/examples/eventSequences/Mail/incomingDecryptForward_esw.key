\javaSource "src";

\programVariables {
    Client self;
    Client client;
    Client receiver;
    Email msg;
    int privkey;
    boolean cond1;
    boolean cond2;
}

\problem {
    (self != null & client != null & receiver != null & msg != null & msg.isEncrypted = TRUE
        -> \<{
        privkey = client.getPrivateKey();
        if (privkey != 0 && msg.isEncrypted() && self.isKeyPairValid(msg.getEmailEncryptionKey(), privkey)) {
            cond1 = msg.isEncrypted() == true;
            msg.setEmailIsEncrypted(false);
            msg.setEmailEncryptionKey(0);
        }
        self.deliver(client, msg);
        receiver = client.getForwardReceiver();
        if (receiver != null) {
            cond2 = msg.isEncrypted() == false;
            self.forward(receiver, msg);
        }
	}\> !eventSeq(seqConcat(seqSingleton(\if(event(Email_setEmailIsEncrypted_boolean, cond1))\then(TRUE)\else(FALSE)), seqSingleton(\if(event(Client_forward_Client_Email, cond2))\then(TRUE)\else(FALSE)))))
}

/*
}*/
